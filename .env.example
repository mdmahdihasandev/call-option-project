# Supabase public browser configuration. Do not put a service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# In development Vite proxies to the local Socket.IO signaling server.
# In production set this to the HTTPS/WSS-capable signaling server URL.
VITE_SIGNALING_URL=https://your-signaling-server.example.com
